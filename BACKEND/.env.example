# Server Configuration
PORT=5000
NODE_ENV=production

# JWT Authentication
JWT_SECRET=your-production-jwt-secret-key-must-be-strong
JWT_EXPIRES_IN=24h

# Database Configuration (MongoDB Atlas Cluster or Local MongoDB)
MONGODB_URI=mongodb+srv://username:password@cluster0.example.mongodb.net/
DB_NAME=e-Commerce

# Redis Cache Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Email Notification Service
EMAIL_USER=info@example.com
EMAIL_PASS=your-email-app-password

# Payment Gateway (Razorpay)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxx

# Logging Level
LOG_LEVEL=info
