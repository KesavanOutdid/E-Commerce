{
	"info": {
		"_postman_id": "e-commerce-split-collection",
		"name": "E-Commerce Categories & Products APIs (Split)",
		"description": "API collection with separate Category and Subcategory endpoints.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "1. MAIN CATEGORIES",
			"item": [
				{
					"name": "Add Main Category",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 201) {",
									"    const response = pm.response.json();",
									"    pm.environment.set(\"main_category_id\", response.data.categoryId || response.data._id);",
									"    console.log(\"✅ Main category created successfully. ID saved.\");",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{admin_token}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Electronics\",\n  \"slug\": \"electronics\",\n  \"createdBy\": \"{{admin_id}}\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/categories/main",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"categories",
								"main"
							]
						},
						"description": "Create a top-level category (Level 1)."
					},
					"response": []
				},
				{
					"name": "Update Main Category",
					"request": {
						"method": "PUT",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{admin_token}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Electronics v2\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/categories/main/{{main_category_id}}",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"categories",
								"main",
								"{{main_category_id}}"
							]
						}
					},
					"response": []
				},
				{
					"name": "View Main Categories",
					"request": {
						"method": "GET",
						"url": {
							"raw": "{{base_url}}/api/categories/main",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"categories",
								"main"
							]
						}
					},
					"response": []
				},
				{
					"name": "Delete Main Category",
					"request": {
						"method": "DELETE",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{admin_token}}"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/categories/main/{{main_category_id}}",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"categories",
								"main",
								"{{main_category_id}}"
							]
						}
					},
					"response": []
				}
			]
		},
		{
			"name": "2. SUBCATEGORIES",
			"item": [
				{
					"name": "Add Subcategory",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 201) {",
									"    const response = pm.response.json();",
									"    pm.environment.set(\"subcategory_id\", response.data.categoryId || response.data._id);",
									"    console.log(\"✅ Subcategory created successfully. ID saved.\");",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{admin_token}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Smartphones\",\n  \"slug\": \"smartphones\",\n  \"parentId\": \"{{main_category_id}}\",\n  \"createdBy\": \"{{admin_id}}\",\n  \"attributes\": [\n    { \"name\": \"RAM\", \"slug\": \"ram\", \"type\": \"text\", \"required\": true }\n  ]\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/categories/sub",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"categories",
								"sub"
							]
						},
						"description": "Create a subcategory (Level 2) under a main category. Attributes are stored directly in this document."
					},
					"response": []
				},
				{
					"name": "Update Subcategory",
					"request": {
						"method": "PUT",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{admin_token}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Premium Smartphones\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/categories/sub/{{subcategory_id}}",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"categories",
								"sub",
								"{{subcategory_id}}"
							]
						}
					},
					"response": []
				},
				{
					"name": "Add Attributes to Subcategory",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{admin_token}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"attributes\": [\n    { \"name\": \"RAM\", \"slug\": \"ram\", \"type\": \"text\", \"required\": true },\n    { \"name\": \"Storage\", \"slug\": \"storage\", \"type\": \"text\", \"required\": true }\n  ]\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/categories/sub/{{subcategory_id}}/attributes",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"categories",
								"sub",
								"{{subcategory_id}}",
								"attributes"
							]
						},
						"description": "Add or replace attributes array for a specific category."
					},
					"response": []
				},
				{
					"name": "View Subcategories of Parent",
					"request": {
						"method": "GET",
						"url": {
							"raw": "{{base_url}}/api/categories/sub/{{main_category_id}}",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"categories",
								"sub",
								"{{main_category_id}}"
							]
						}
					},
					"response": []
				},
				{
					"name": "Delete Subcategory",
					"request": {
						"method": "DELETE",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{admin_token}}"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/categories/sub/{{subcategory_id}}",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"categories",
								"sub",
								"{{subcategory_id}}"
							]
						}
					},
					"response": []
				}
			]
		}
	
	]
}