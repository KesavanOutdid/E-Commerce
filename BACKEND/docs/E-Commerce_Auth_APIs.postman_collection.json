					"name": "1. Registration Flow",
					"item": [
						{
							"name": "Send Registration OTP",
							"event": [
								{
									"listen": "test",
									"script": {
										"exec": [
											"if (pm.response.code === 200) {",
											"    const response = pm.response.json();",
											"    const requestBody = JSON.parse(pm.request.body.raw);",
											"    pm.environment.set(\"test_email\", requestBody.email);",
											"    console.log(\"✅ OTP sent successfully. Check backend console for OTP code.\");",
											"}"
										],
										"type": "text/javascript"
									}
								}
							],
							"request": {
								"method": "POST",
								"header": [
									{
										"key": "Content-Type",
										"value": "application/json"
									}
								],
								"body": {
									"mode": "raw",
									"raw": "{\n  \"email\": \"john.doe@example.com\"\n}"
								},
								"url": {
									"raw": "{{base_url}}/api/user/register/send-otp",
									"host": [
										"{{base_url}}"
									],
									"path": [
										"api",
										"user",
										"register",
										"send-otp"
									]
								},
								"description": "Send OTP to email for user registration. OTP is valid for 180 seconds."
							},
							"response": []
						},
						{
							"name": "Complete Registration",
							"event": [
								{
									"listen": "test",
									"script": {
										"exec": [
											"if (pm.response.code === 201) {",
											"    const response = pm.response.json();",
											"    pm.environment.set(\"user_token\", response.data.accessToken);",
											"    pm.environment.set(\"user_id\", response.data.userId);",
											"    console.log(\"✅ User registered successfully. Token saved.\");",
											"}"
										],
										"type": "text/javascript"
									}
								}
							],
							"request": {
								"method": "POST",
								"header": [
									{
										"key": "Content-Type",
										"value": "application/json"
									}
								],
								"body": {
									"mode": "raw",
									"raw": "{\n  \"firstName\": \"John\",\n  \"lastName\": \"Doe\",\n  \"email\": \"john.doe@example.com\",\n  \"phone\": \"9876543210\",\n  \"password\": \"SecurePass@123\",\n  \"otpCode\": \"123456\"\n}"
