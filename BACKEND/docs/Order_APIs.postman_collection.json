						"url": {
							"raw": "{{base_url}}/api/orders/detail/{{order_id}}",
							"host": ["{{base_url}}"],
							"path": ["api", "orders", "detail", "{{order_id}}"]
						},
						"description": "Get detailed information for a specific order. Order items include variantId and sellerId if the item was purchased from a variant. Only returns orders belonging to the logged-in user."
					},
					"response": []
				}
			]
		},
